# Copy to .env and edit. Read by the API (pydantic-settings) and the web app.

MIRU_DATABASE_URL=postgresql+psycopg://miru:miru@localhost/miru

# Colon-separated, like PATH. WSL paths, not Windows paths:
#   /mnt/d/Media/Anime  — right
#   D:\Media\Anime      — wrong, scans nothing
MIRU_LIBRARY_PATHS=/mnt/d/Media

# Empty = open API. Correct on localhost, wrong once Tailscale can reach it.
MIRU_TOKEN=

MIRU_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- transcode worker on the PC ---
# Tailscale MagicDNS name, not a static IP: tailnet addresses are stable by
# identity and keep working if either machine changes network.
# Needs WSL2 mirrored networking to be reachable — see docs/DEPLOYMENT.md §5.
MIRU_TRANSCODE_WORKER=http://miru-pc:8001

# --- acquisition, both on the PC ---
# Prowlarr owns indexer definitions so Miru never parses a torrent site's HTML.
MIRU_PROWLARR_URL=http://100.67.44.13:9696
MIRU_PROWLARR_API_KEY=
# aria2 owns downloading: resume, queueing, and a real completion signal.
# Its own config sets dir=/mnt/incoming, so Miru never names a remote path.
MIRU_ARIA2_URL=http://100.67.44.13:6800
MIRU_ARIA2_SECRET=

# ── Downloader ───────────────────────────────────────────────────────────────
# qbittorrent (default) or aria2. qBittorrent is the default because it is the
# only one of the two that can be watched while it is still arriving: aria2 1.37
# has no sequential download for BitTorrent at all, so a file it is fetching is
# unwatchable until the last piece lands. Falling back is this one variable.
MIRU_DOWNLOADER=qbittorrent

# qbittorrent-nox on the PC. Web UI port, not the BitTorrent port.
MIRU_QBITTORRENT_URL=http://100.67.44.13:8080
MIRU_QBITTORRENT_USER=admin
MIRU_QBITTORRENT_PASSWORD=
# Left empty so qBittorrent's own save path wins. Miru never names a directory
# that lives on the other machine.
MIRU_QBITTORRENT_SAVE_PATH=

# ── Browse seeds ─────────────────────────────────────────────────────────────
# Extra searches run on every refresh, alongside the empty browse query. Browse
# returns each indexer's front page, which is whatever the world is downloading,
# so anything regional never reaches the wall on its own. Measured: "tagalog"
# returns 257 results and none of them appear in an unfiltered browse.
MIRU_CATALOG_QUERIES=tagalog,filipino,pinoy

# ── Artwork ──────────────────────────────────────────────────────────────────
# AniList (anime) and TVmaze (series) need no key and work out of the box.
# TMDB is the only source with real film coverage and the only one that needs a
# key: https://www.themoviedb.org/settings/api — free, and takes a minute.
# Without it, films fall back to generated title cards rather than breaking.
MIRU_TMDB_API_KEY=
MIRU_POSTER_CACHE_PATH=/mnt/storage/miru-posters
