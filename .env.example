# Copy to .env and edit. Read by the API (pydantic-settings) and the web app.

MIRU_DATABASE_URL=postgresql+psycopg://miru:miru@localhost/miru

# Colon-separated, like PATH. WSL paths, not Windows paths:
#   /mnt/d/Media/Anime  — right
#   D:\Media\Anime      — wrong, scans nothing
MIRU_LIBRARY_PATHS=/mnt/d/Media

# Empty = open API. Correct on localhost, wrong once Tailscale can reach it.
MIRU_TOKEN=

MIRU_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- transcode PC (Wake-on-LAN) ---
# MAC of the PC's ETHERNET adapter. WoWLAN over wifi does not work reliably.
# On the PC:  Get-NetAdapter | Select-Object Name, MacAddress, Status
MIRU_PC_MAC=
# Subnet broadcast address; 255.255.255.255 works on a flat home LAN.
MIRU_PC_BROADCAST=255.255.255.255
# NVENC worker on the PC, over the tailnet.
MIRU_TRANSCODE_WORKER=http://100.x.x.x:8001
