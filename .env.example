# Copy to .env and edit. Read by the API (pydantic-settings) and the web app.

MIRU_DATABASE_URL=postgresql+psycopg://miru:miru@localhost/miru

# Colon-separated, like PATH. WSL paths, not Windows paths:
#   /mnt/d/Media/Anime  — right
#   D:\Media\Anime      — wrong, scans nothing
MIRU_LIBRARY_PATHS=/mnt/d/Media

# Empty = open API. Correct on localhost, wrong once Tailscale can reach it.
MIRU_TOKEN=

MIRU_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- transcode worker on the PC ---
# Tailscale MagicDNS name, not a static IP: tailnet addresses are stable by
# identity and keep working if either machine changes network.
# Needs WSL2 mirrored networking to be reachable — see docs/DEPLOYMENT.md §5.
MIRU_TRANSCODE_WORKER=http://miru-pc:8001

# --- acquisition, both on the PC ---
# Prowlarr owns indexer definitions so Miru never parses a torrent site's HTML.
MIRU_PROWLARR_URL=http://100.67.44.13:9696
MIRU_PROWLARR_API_KEY=
# aria2 owns downloading: resume, queueing, and a real completion signal.
# Its own config sets dir=/mnt/incoming, so Miru never names a remote path.
MIRU_ARIA2_URL=http://100.67.44.13:6800
MIRU_ARIA2_SECRET=
